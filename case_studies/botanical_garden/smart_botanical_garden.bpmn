    <bpmn:textAnnotation id="TextAnnotation_180v2wf">
      <bpmn:text>Condition: myPlace().soil_moisture &lt;= myPlace().min_moisture</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_07ngkld">
      <bpmn:text>Condition: myPlace().soil_moisture &gt;= myPlace().target_moisture</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1p8qnht">
      <bpmn:text>Assignment: myPlace().soil_status = "dry"</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1drziq0">
      <bpmn:text>Condition  myPlace().irrigation_status == "irrigating"</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ohjqqx">
      <bpmn:text>Assignment: myPlace().sprinkler_status = "on"</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ob6dky">
      <bpmn:text>Condition:  myPlace().irrigation_status == "waiting" || myPlace().irrigation_status == "irrigated"</bpmn:text>
    </bpmn:textAnnotation>
