  <bpmn:process id="Garden_Guide" isExecutable="true" camunda:historyTimeToLive="0">
    <bpmn:startEvent id="Event_0ag7ohs" name="Tour session started">
      <bpmn:outgoing>Flow_1lssswl</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="Event_0ca559t" name="Receive visitor preferences">
      <bpmn:extensionElements>
        <camunda:executionListener delegateExpression="${catchMessageDelegate}" event="end">
          <camunda:field name="getVariableValue">
            <camunda:string>Visit_settings</camunda:string>
          </camunda:field>
          <camunda:field name="setVariableExpr">
            <camunda:string>Guided_Visit_settings</camunda:string>
          </camunda:field>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1lssswl</bpmn:incoming>
      <bpmn:outgoing>Flow_14iu3o4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1onqtwn">
        <bpmn:targetRef>DataObjectReference_10zxrpm</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1rrlqo3" messageRef="Message_1jl01ju" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Activity_03ntpcw" name="Pick up visitor">
      <bpmn:extensionElements>
        <space:type>binding</space:type>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14iu3o4</bpmn:incoming>
      <bpmn:outgoing>Flow_1ygdfgd</bpmn:outgoing>
    </bpmn:task>
