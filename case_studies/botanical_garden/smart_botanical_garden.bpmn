      <bpmn:incoming>Flow_1ygdfgd</bpmn:incoming>
      <bpmn:incoming>Flow_0i5407s</bpmn:incoming>
      <bpmn:outgoing>Flow_00rwg63</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_0fwnbyw" name="Move to botanical area">
      <bpmn:extensionElements>
        <space:type>movement</space:type>
        <space:destination>${Guided_Visit_settings.targetPlaceIds[0]}</space:destination>
