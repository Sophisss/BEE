    <bpmn:intermediateCatchEvent id="Event_1oah0vg" name="Stop or Wait Request Detected">
      <bpmn:incoming>Flow_00uc9yp</bpmn:incoming>
      <bpmn:outgoing>Flow_0avu76p</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="ConditionalEventDefinition_1fj03k4">
